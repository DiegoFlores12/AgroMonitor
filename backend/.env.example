# ---------------------------------------------------------------------------
# empresa-backend - variables de entorno
# Copia este archivo a .env y completa los valores reales. .env NUNCA se
# sube al repositorio (ver .gitignore).
# ---------------------------------------------------------------------------

# Puerto donde corre este backend
PORT=3000

# Orígenes del frontend para Live Server o servidor local en desarrollo.
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500,http://127.0.0.1:5500

# El refresh_token vive en una cookie httpOnly puesta por este backend (ver
# README, "Seguridad"): por defecto solo viaja por HTTPS (Secure). Si vas a
# probar el panel en local por HTTP (sin HTTPS), descomenta esta línea; en
# cualquier servidor real déjala tal cual (o bórrala) para que quede en true.
# COOKIE_SECURE=false

# --- auth-2fa-api-go (API externa, ya desplegada, NO se toca ni se recrea) ---
# URL base de la API de autenticación.
# - En local (tu computador): la URL pública, como abajo.
# - En Dokploy, en el servicio de este backend: la dirección interna de la auth-api,
#   http://auth2fa-api-go-vhrgpq:8080 (http, no https: es tráfico dentro de la red
#   privada de Docker). Así la auth-api ve la IP real de cada persona (este backend
#   se la manda en X-Forwarded-For) y no la de este servidor, y sus límites por IP
#   y su lista negra cuentan por persona. Requiere que la auth-api tenga
#   TRUSTED_PROXY_CIDRS con la red de Docker (10.0.1.0/24).
AUTH_API_URL=https://auth2fa-api-go-vhrgpq-fddfce-132-145-207-151.sslip.io

# API key del tenant (header X-API-Key). Identifica a "empresa-app" como
# sistema consumidor ante la auth-api; los usuarios quedan aislados por esta
# key. IMPORTANTE: esta key SOLO debe vivir en el backend, nunca en el
# frontend (ver README, sección "Seguridad"). Reemplaza con tu propia key
# real (rota cualquier key que hayas compartido antes por accidente).
AUTH_API_KEY=sk_live_reemplaza_esto_con_tu_api_key_real

# (Opcional) Credencial de administración de la auth-api SOLO para los
# usuarios de este sistema (header X-System-Admin-Token): bloquear/desbloquear
# también en la auth-api, cerrar sesiones, desactivar la app autenticadora y
# ver todas las cuentas registradas (incluidas las que nunca completaron su
# primer login) desde el panel. La provisiona el operador de la auth-api.
# Solo backend. Sin ella, el panel bloquea solo localmente y no muestra
# "Cuentas registradas".
# AUTH_API_SYSTEM_ADMIN_TOKEN=sk_live_reemplaza_esto

# (Opcional) Tiempo máximo de espera de cada llamada a la auth-api, en ms.
# Si no responde a tiempo, el backend contesta 503 "servicio no disponible".
# AUTH_API_TIMEOUT_MS=10000

# (Opcional) Zona horaria con la que se interpretan los filtros por fecha del
# registro de actividad. Por defecto America/Santiago.
# APP_TIMEZONE=America/Santiago

# (Opcional) Pide el PIN de la cuenta en las acciones destructivas del
# superadmin (cambiar rol, bloquear/desbloquear, cerrar sesiones, desactivar la
# app autenticadora, resetear el PIN de otra persona). Apagado por defecto:
# enciéndelo cuando la app y la web ya envíen el campo `pin`.
# ADMIN_PIN_ENFORCED=true
# Roles que deben ingresar su PIN como último paso del login (tras la contraseña
# y el segundo factor). Lista separada por comas: superadmin, admin y/o user. Sin
# definir, el backend no toca este interruptor; definida pero vacía, nadie lo exige
# (y se apaga donde estaba puesto). Defínela DESPUÉS de desplegar el frontend con
# la pantalla de PIN; requiere la auth-api con PIN de login. Para exigirlo también
# a los usuarios comunes, agrega "user" (antes, que la app móvil entienda el paso).
# LOGIN_PIN_ROLES=superadmin,admin

# --- Limpieza automática de registros antiguos (opcional) ---
# Días que se guardan el historial de inicios de sesión y el registro de
# actividad. Se limpia al arrancar y luego una vez al día. 0 = no borrar nunca.
# LOGIN_HISTORY_RETENTION_DAYS=365
# AUDIT_LOG_RETENTION_DAYS=1095

# --- Base de datos propia de la empresa (independiente de la de auth-api) ---
# URL de conexión a PostgreSQL. Las tablas se crean solas al arrancar.
# Ejemplos:
#   local: postgresql://postgres:postgres@localhost:5432/empresa_db
#   Neon:  postgresql://USUARIO:PASSWORD@HOST/empresa_db?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/empresa_db
